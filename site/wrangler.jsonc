{
  // The site on Cloudflare Workers: static assets, plus a tiny Worker for /api/* (live GitHub stars).
  // Deploy with: npm run deploy
  "name": "standard-music",
  "compatibility_date": "2025-10-01",
  "main": "./worker/index.js",
  // Served at music.standardagents.ai (Cloudflare adds the DNS record and certificate on deploy);
  // standard-music.formkit.workers.dev keeps working too.
  "routes": [{ "pattern": "music.standardagents.ai", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
